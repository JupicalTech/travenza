<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="owl.DashboardTemplate" owl="1">
    <div class="o_control_panel flex-column px-3 pt-2 pb-3">
            <div class="o_control_panel_actions d-empty-none d-flex align-items-center justify-content-start justify-content-lg-around order-2 order-lg-1 w-100 w-lg-auto">
                <div class="col-1">
                    <select id="blockType" name="blockType"  t-on-change="changeBlockType" class="o-autocomplete--input o_input">
                        <option value="graph">Chart</option>
                        <option value="tile">Tile</option>
                    </select>
                </div>
                <div class="col-1" t-if="state.isChart">
                    <select id="chartType" name="chartType" class="o-autocomplete--input o_input" style="
    color: #241f1e61">
                        <option value="">Chart Type</option>
                        <option value="bar">Bar</option>
                        <option value="pie">Pie</option>
                        <option value="radar">Radar</option>
                        <option value="line">Line</option>
                        <option value="doughnut">Doughnut</option>
                        <option value="list">List</option>
                    </select>
                </div>
                <div class="col-1" t-if="state.isChart">
                    <select id="graphSize" name="graphSize" class="o-autocomplete--input o_input" style="
    color: #241f1e61">
                        <option value="">Graph Size</option>
                        <option value="col-lg-4">Small</option>
                        <option value="col-lg-6">Medium</option>
                        <option value="col-lg-12">Large</option>
                    </select>
                </div>
                <div class="col-2">
                    <select id="modelId" name="modelId" class="o-autocomplete--input o_input" t-on-change="onModelChange" style="
    color: #241f1e61">
                        <option value="">Model</option>
                        <t t-foreach="state.models" t-as="model" t-key="model.id">
                            <option t-att-value="model.id" t-esc="model.name"/>
                        </t>
                    </select>
                </div>
                <div class="col-1">
                    <select id="operationType" name="operationType" class="o-autocomplete--input o_input" t-on-change="operationType" style="
    color: #241f1e61">
                        <option value="">Operation Type</option>
                        <option value="sum">Sum</option>
                        <option value="avg">Average</option>
                        <option value="count">Count</option>
                    </select>
                </div>
                <div class="col-1">
                    <select id="fieldId" name="fieldId" class="o-autocomplete--input o_input" style="
    color: #241f1e61">
                        <t t-if="state.fields">
                            <option value="">Measured</option>
                            <t t-foreach="state.fields" t-as="field" t-key="field.id">
                                <option t-att-value="field.id" t-esc="field.name"/>
                            </t>
                        </t>
                    </select>
                </div>
                <div class="col-1" t-if="state.isChart">
                    <select id="groupByfieldId" name="groupByfieldId" class="o-autocomplete--input o_input" style="
    color: #241f1e61">
                        <t t-if="state.groupby_fields">
                            <option value="">GroupBy</option>
                            <t t-foreach="state.groupby_fields" t-as="field" t-key="field.id">
                                <option t-att-value="field.id" t-esc="field.name"/>
                            </t>
                        </t>
                    </select>
                </div>
                <div t-if="state.isTile">
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle" type="button" id="iconDropdown" data-bs-toggle="dropdown" aria-expanded="false" t-on-click="initIconSelection">
                            Icon
                        </button>
                        <div class="dropdown-menu" aria-labelledby="iconDropdown">
                            <div class="icon-container">
                                <div class="icon-row">
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-star"><i class="fa fa-star"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-pencil"><i class="fa fa-pencil"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-address-book"><i class="fa fa-address-book"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-user-circle-o"><i class="fa fa-user-circle-o"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-car"><i class="fa fa-car"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-book"><i class="fa fa-book"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-bookmark"><i class="fa fa-bookmark"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-calendar-plus-o"><i class="fa fa-calendar-plus-o"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-check-circle"><i class="fa fa-check-circle"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-circle"><i class="fa fa-circle"></i></a>
                                </div>
                                <div class="icon-row">
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-check-square-o"><i class="fa fa-check-square-o"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-cloud-upload"><i class="fa fa-cloud-upload"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-cubes"><i class="fa fa-cubes"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-eye"><i class="fa fa-eye"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-folder-open"><i class="fa fa-folder-open"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-minus"><i class="fa fa-minus"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-phone"><i class="fa fa-phone"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-picture-o"><i class="fa fa-picture-o"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-plus"><i class="fa fa-plus"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-server"><i class="fa fa-server"></i></a>
                                </div>
                                <div class="icon-row">
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-sign-in"><i class="fa fa-sign-in"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-plus-circle"><i class="fa fa-plus-circle"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-signal"><i class="fa fa-signal"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-tags"><i class="fa fa-tags"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-archive"><i class="fa fa-archive"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-file"><i class="fa fa-file"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-cog"><i class="fa fa-cog"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-money"><i class="fa fa-money"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-usd"><i class="fa fa-usd"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-inr"><i class="fa fa-inr"></i></a>
                                </div>

                                <div class="icon-row">
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-adjust"><i class="fa fa-adjust"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-area-chart"><i class="fa fa-area-chart"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-bars"><i class="fa fa-bars"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-bell"><i class="fa fa-bell"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-briefcase"><i class="fa fa-briefcase"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-calculator"><i class="fa fa-calculator"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-calendar-o"><i class="fa fa-calendar-o"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-clock-o"><i class="fa fa-clock-o"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-users"><i class="fa fa-users"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-hourglass-start"><i class="fa fa-hourglass-start"></i></a>
                                </div>
                                <div class="icon-row">
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-star-half-o"><i class="fa fa-star-half-o"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-sun-o"><i class="fa fa-sun-o"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-toggle-on"><i class="fa fa-toggle-on"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-trash"><i class="fa fa-trash"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-envelope-o"><i class="fa fa-envelope-o"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-flag"><i class="fa fa-flag"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-info-circle"><i class="fa fa-info-circle"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-commenting-o"><i class="fa fa-commenting-o"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-history"><i class="fa fa-history"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-recycle"><i class="fa fa-recycle"></i></a>
                                </div>
                                <div class="icon-row">
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-chain-broken"><i class="fa fa-chain-broken"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-paperclip"><i class="fa fa-paperclip"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-windows"><i class="fa fa-windows"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-share-alt"><i class="fa fa-share-alt"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-android"><i class="fa fa-android"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-superpowers"><i class="fa fa-superpowers"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-window-restore"><i class="fa fa-window-restore"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-podcast"><i class="fa fa-podcast"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-handshake-o"><i class="fa fa-handshake-o"></i></a>
                                    <a class="dropdown-item_custom icon-btn" href="#" data-icon="fa fa-window-maximize"><i class="fa fa-window-maximize"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <input type="text" id="iconClass" name="iconClass" style="display:none;"/>
                </div>
                <div t-if="state.isTile">
                    <div id="selectedIconContainer" class="col-6 mb-1">
                        <i id="selectedIcon" class="fa"></i>
                    </div>
                </div>
                <div t-if="state.isTile">
                    <div class="text-center">
                        <label for="colorPicker" class="form-label">Tile Color</label>
                        <input type="color" id="colorPicker" name="colorPicker" class="form-control" t-on-change="changeColor" t-att-value="state.tileColor"/>
                    </div>
                </div>
                <div t-if="state.isTile">
                    <div class="text-center">
                        <label for="iconcolorPicker" class="form-label">Icon Color</label>
                        <input type="color" id="iconcolorPicker" name="iconcolorPicker" class="form-control" t-on-change="changeIconColor"/>
                    </div>
                </div>
                <div t-if="state.isTile">
                    <div class="text-center">
                        <label for="textcolorPicker" class="form-label">Text Color</label>
                        <input type="color" id="textcolorPicker" name="textcolorPicker" class="form-control" t-on-change="changeTextColor" t-att-value="state.textColor"/>
                    </div>
                </div>
                <div>
                    <div class="text-center" style="font-size: 15px;">
                        <button class="btn btn-primary" type="button" t-on-click="_onClick_add_block">Add</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-fluid" style="padding:20px;">
            <div class="o_dynamic_dashboard row">
                <div class="o_dynamic_tile row"></div>
                <div class="o_dynamic_graph w3-container row"></div>
            </div>
        </div>
    </t>
</templates>    