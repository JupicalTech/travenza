<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="jt_dynamic_dashboard.JtColorPicker" owl="1">
        <div>
            <input type="color" id="tileColorInput" class="round-color-input" t-on-change="onColorChange"  t-att-value="state.color_value"/>
        </div>
    </t>

    <t t-name="jt_dynamic_dashboard.JttextColorPicker" owl="1">
        <div>
            <input type="color" id="textColorInput" class="round-color-input" t-on-change="onTextColorChange" t-att-value="state.text_color_value"/>
        </div>
    </t>

    <t t-name="jt_dynamic_dashboard.JtIconColorPicker" owl="1">
        <div>
            <input type="color" id="iconColorInput" class="round-color-input" t-on-change="onIconColorChange" t-att-value="state.icon_color_value"/>
        </div>
    </t>

    <t t-name="jt_dynamic_dashboard.JtCustomIcon" owl="1">
        <div>
            <input type="file" t-on-change="onInputChange"/>
            <img t-att-src="state.imgSrc" style="max-width: 100px; max-height: 100px;" alt="your image"/>
        </div>
    </t>


