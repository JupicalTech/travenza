<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="jt_dynamic_dashboard_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dynamic.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="0"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Dashboard Settings" string="Dynamic Dashboard" name="jt_dynamic_dashboard" logo="/jt_dynamic_dashboard/static/description/icon.png">
                    <block title="Icon Configuration" name="icon_configuration" invisible="not is_root_company">
                       <setting id="image_size" string="Icon Size" help="Configure image size(Kb)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="image_size" placeholder="153.54"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="gif_size" string="GIF Icon Size" help="Configure GIF size(Kb)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="gif_size" placeholder="1530.54"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="jt_dynamic_dashboard_config" model="ir.actions.act_window">
        <field name="name">Dashboard Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="jt_dynamic_dashboard_config_settings_view_form"/>
        <!-- <field name="target">inline</field> -->
        <field name="context">{'module' : 'jt_dynamic_dashboard'}</field>
    </record>

</odoo>