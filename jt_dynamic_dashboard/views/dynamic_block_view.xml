                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <separator/>
                    <separator invisible="type == 'graph'"/>
                    <separator invisible="type == 'graph'"/>
                    <separator invisible="type == 'graph'"/>
                    <group>
                        <group>
                            <field name="model_id"
                                   required="[('edit_mode','=', True)]"/>
                            <field name="client_action" invisible="1"/>
                            <field name="model_name" invisible="1"/>
                            <field name="edit_mode" invisible="1"/>
                            <field name="operation"
                                   required="[('edit_mode','=', True)]"/>
                            <field name="measured_field"
                                   domain="[('model_id','=',model_id), ('ttype','in',['float','integer','monetary']), ('store', '=', True)]"
                                   required="[('edit_mode','=', True)]"/>
                            <field name="filter" widget="domain"
                                   options="{'model': 'model_name'}"/>
                        </group>
                        <group>
                            <field name="sequence" invisible="1"/>
                            <field name="type" required="1"/>
                            <field name="tiles_type" invisible="type != 'tile'"/>
                            <field name="graph_type"
                                   invisible="type == 'tile'"/>
                            <field name="graph_size"
                                   invisible="type == 'tile'"/>
                            <field name="group_by" invisible="type == 'tile'"
                                   required="[('edit_mode','=', True),('type','=','graph')]"
                                   domain="[('model_id','=',model_id), ('ttype','!=','one2many'), ('store', '=', True)]"/>
                            <field name="icon_type" widget="radio"  invisible="type == 'graph'"/>
                            <field name="fa_color" invisible="icon_type == 'custom' or type == 'graph'" widget="jticoncolor"/>
                            <field name="tile_color" invisible="type == 'graph'" widget="jtcolor"/>
                            <field name="optional_tile_color" invisible="tiles_type != '4'" widget="color"/>
                            <field name="text_color" invisible="type == 'graph'" widget="jttextcolor"/>
                            <field name="fa_icon" invisible="1"/>
                            <field name="custom_icon" invisible="icon_type == 'default' or type == 'graph'"  widget="jtcustomicon"/>
                            <field name="icon_image" widget="binary" invisible="1"/>
                            <field name="file_name" invisible="1"/>
                            <field name="icon_picker" invisible="icon_type == 'custom' or type == 'graph'" widget="jticonpicker"/>
                            <field name="is_demo_data" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--    tree view of the model dashboard block-->

    <record id="jt_dashboard_block_view_tree" model="ir.ui.view">
        <field name="name">dashboard.block.view.tree</field>
        <field name="model">dashboard.block</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="type"/>
            </list>
        </field>
    </record>

        <!--    search view of the model dashboard block-->

    <record id="jt_dashboard_search" model="ir.ui.view">
        <field name="name">dashboard.block.view.search</field>
        <field name="model">dashboard.block</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <field name="type"/>
                <group>
                    <filter string="Models" name="models" context="{'group_by':'model_id'}"/>
                    <filter string="Demo Data" name="is_demo_data" context="{'group_by':'is_demo_data'}"/>
                </group>
            </search>
        </field>
    </record>

    <!--    Action of the model dashboard block-->

    <record id="jt_dashboard_block_tiles_action" model="ir.actions.act_window">
        <field name="name">Block</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dashboard.block</field>
        <field name="domain">[('type','=', 'tile')]</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_edit_mode' : True, 'default_type':'tile'}</field>
    </record>

    <record id="jt_dashboard_block_charts_action" model="ir.actions.act_window">
        <field name="name">Block</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dashboard.block</field>
        <field name="domain">[('type','=', 'graph')]</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_edit_mode' : True, 'default_type':'graph'}</field>
    </record>
</odoo>
