<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="seq_customer_booking" model="ir.sequence">
            <field name="name">Customer Booking Sequence</field>
            <field name="code">customer.booking</field>
            <field name="prefix">BKG/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_customer_visa_application" model="ir.sequence">
            <field name="name">Visa Application Sequence</field>
            <field name="code">customer.visa.application</field>
            <field name="prefix">VISA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
</odoo>