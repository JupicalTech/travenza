<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="module_category_travenza_holidays" model="ir.module.category">
        <field name="name">Travenza Holidays</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_travenza_holidays_privilege" model="res.groups.privilege">
        <field name="name">Travenza Access Rights</field>
        <field name="category_id" ref="module_category_travenza_holidays"/>
    </record>

    <record id="group_travenza_holidays_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="group_travenza_holidays_privilege"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>


    <record id="group_travenza_holidays_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="sequence">2</field>
        <field name="privilege_id" ref="group_travenza_holidays_privilege"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>


    <record id="group_travenza_holidays_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">3</field>
        <field name="privilege_id" ref="group_travenza_holidays_privilege"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="group_travenza_holidays_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">4</field>
        <field name="privilege_id" ref="group_travenza_holidays_privilege"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>


</odoo>