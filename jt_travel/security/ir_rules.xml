<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="rule_accountant_submitted_only" model="ir.rule">
            <field name="name">Accountant: See Submitted Bills Only</field>
            <field name="model_id" ref="model_travel_billing"/>
            <field name="groups" eval="[(4, ref('jt_travel.group_travenza_holidays_accountant'))]"/>
            <field name="domain_force">[('state', 'in', ['submitted', 'pending', 'completed'])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_travel_quotation_assignee" model="ir.rule">
            <field name="name">Travel Quotation: Assigned User Access</field>
            <field name="model_id" ref="model_travel_quotation"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', '|', ('assign_to_id', '=', user.id), ('lead_id.user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        </record>

        <record id="rule_crm_lead_via_quotation_assignee" model="ir.rule">
            <field name="name">CRM Lead: Access via Owner or Quotation</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('quotation_ids.assign_to_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_travel_quotation_manager_all" model="ir.rule">
            <field name="name">Travel Quotation: Manager/Admin See All</field>
            <field name="model_id" ref="model_travel_quotation"/>
            <field name="groups" eval="[(4, ref('jt_travel.group_travenza_holidays_manager')), (4, ref('jt_travel.group_travenza_holidays_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_crm_lead_via_task_assignee" model="ir.rule">
            <field name="name">CRM Lead: Access via Task Assignee</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('project_ids.task_ids.user_ids', 'in', [user.id]), ('lead_task_ids.user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_visa_application_assignee" model="ir.rule">
            <field name="name">Visa Application: Assignee Access</field>
            <field name="model_id" ref="model_travel_visa_application"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">
                ['|', '|',
                    ('assignee_id', '=', user.id),
                    ('lead_id.user_id', '=', user.id),
                    ('create_uid', '=', user.id)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_visa_application_manager_all" model="ir.rule">
            <field name="name">Visa Application: Manager/Admin See All</field>
            <field name="model_id" ref="model_travel_visa_application"/>
            <field name="groups" eval="[(4, ref('jt_travel.group_travenza_holidays_manager')), (4, ref('jt_travel.group_travenza_holidays_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>



        <record id="rule_crm_lead_accountant_all" model="ir.rule">
            <field name="name">CRM Lead: Accountant See All</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="groups" eval="[(4, ref('jt_travel.group_travenza_holidays_accountant'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>



    </data>
</odoo>