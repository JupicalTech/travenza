<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_travel_billing_refund_wizard_form" model="ir.ui.view">
        <field name="name">travel.billing.refund.wizard.form</field>
        <field name="model">travel.billing.refund.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark Refunded">
                <group>
                    <field name="billing_id" invisible="1"/>
                    <field name="reason" required="1"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Confirm" class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>