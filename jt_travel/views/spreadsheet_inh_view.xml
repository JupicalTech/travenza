<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spreadsheet_tree_view_done_inherit" model="ir.ui.view">
    <field name="name">spreadsheet.spreadsheet.tree.done.inherit</field>
    <field name="model">spreadsheet.spreadsheet</field>
    <field name="inherit_id" ref="spreadsheet_oca.spreadsheet_spreadsheet_tree_view"/>
    <field name="arch" type="xml">
        <xpath expr="//list//button[@name='open_spreadsheet']" position="after">
            <field name="is_done" widget="boolean_toggle"
                   options="{'terminology': {'string_true': 'Done', 'string_false': 'Pending'}}"/>
        </xpath>
    </field>
</record>
</odoo>