<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="crm_lead_view_form_inherit_visa" model="ir.ui.view">
    <field name="name">crm.lead.form.inherit.visa</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='stage_id']" position="before">
            <field name="is_in_process" invisible="1"/>
        </xpath>
        <xpath expr="//page[@name='lead']/group/group[4]" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>


        <xpath expr="//header" position="inside">
           <field name="is_project_created" invisible="1"/>
            <button name="action_open_project_wizard"
                type="object"
                string="Create Project"
                class="oe_highlight"
                icon="fa-folder"
                invisible="not is_project_type or not id or won_status != 'won' or is_project_created"/>
            <button name="action_create_billing" 
                        string="Create Bill" 
                        type="object" 
                        class="oe_highlight" 
                        invisible="not is_in_process"/>
            <button name="action_create_visa_application" 
                    string="Create Visa Application" 
                    type="object" 
                    class="oe_highlight" 
                    invisible="won_status != 'won' or lead_type_id != %(jt_travel.lead_type_visa_assistance)d" context="{'default_applicant_id': partner_id}"/>
            <button name="action_new_spreadsheet"
                    type="object"
                    string="New Quotation"
                    class="btn btn-primary"
                    icon="fa-table"
                    groups="spreadsheet_oca.group_user"
                    invisible="won_status == 'won'"/>
            <!-- <button name="action_upload_spreadsheet"
                    type="object"
                    string="Upload Spreadsheet"
                    class="btn btn-secondary"
                    icon="fa-upload"
                    groups="spreadsheet_oca.group_user"/> -->

        </xpath>



        <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>



        <xpath expr="//div[@name='button_box']" position="inside">
            <!-- <button name="action_view_tasks"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tasks">
                <field name="task_count" widget="statinfo" string="Tasks"/>
            </button> -->
            <button name="action_view_projects"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-folder"
                    invisible="not is_project_type">
                <field name="project_count" widget="statinfo" string="Projects"/>
            </button>
                 <button name="action_view_billings" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-money">
                    <field name="billing_count" widget="statinfo" string="Bills"/>
                </button>
            <button name="action_view_lead_documents"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-paperclip">
                <field name="document_count" widget="statinfo" string="Documents"/>
            </button>
            <!-- <button name="action_open_travel_quotations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o">
                <field name="quotation_count" widget="statinfo" string="Quotations"/>
            </button> -->
            <button name="action_view_visa_applications" 
                    type="object" 
                    class="oe_stat_button" 
                    icon="fa-globe"
                    invisible="visa_count == 0">
                <field name="visa_count" widget="statinfo" string="Visa Applications"/>
            </button>

            <button name="action_view_spreadsheets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-table"
                    groups="spreadsheet_oca.group_user">
                <field name="spreadsheet_count" widget="statinfo" string="Quotations"/>
            </button>


        </xpath>

        <xpath expr="//field[@name='company_currency']" position="replace">
            <field name="lead_currency_id" invisible="1"/>
        </xpath>

        <xpath expr="//field[@name='expected_revenue']" position="attributes">
            <attribute name="options">{'currency_field': 'lead_currency_id'}</attribute>
        </xpath>

        <xpath expr="//field[@name='partner_id']" position="attributes">
            <attribute name="required">True</attribute>
        </xpath>

        <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="lead_type_id" options="{'no_create': True, 'no_open': True}"/>
        </xpath>
        <xpath expr="//field[@name='tag_ids']" position="before">
            <field name="client_category"/>
        </xpath>


        <xpath expr="//group[@name='opportunity_partner']//div[field[@name='phone']]" position="after">
            <field name="destination"/>
            <label for="travel_date_from" string="Travel Dates"/>
            <div class="o_row">
                <field name="travel_date_from" nolabel="1" class="oe_inline" placeholder="From" widget="custom_datetime"/>
                <i class="fa fa-long-arrow-right mx-2 mt-1 text-muted" title="Arrow" aria-hidden="true"/>
                <field name="travel_date_to" nolabel="1" class="oe_inline" placeholder="To" widget="custom_datetime"/>
            </div>
            <field name="lead_currency_id"/>
        </xpath>

        <xpath expr="//div[field[@name='date_deadline']]/field[@name='priority']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        <xpath expr="//div[field[@name='date_deadline']]" position="after">
            <field name="priority" widget="priority" string="Priority"/>
        </xpath>
        <xpath expr="//field[@name='user_id']" position="replace"/>

        <xpath expr="//field[@name='lead_type_id']" position="after">
            <field name="allowed_user_ids" invisible="1"/>
            <field name="user_id" string="Assigned Owner" domain="[('share', '=', False), ('id', 'in', allowed_user_ids)]" options="{'no_create': True}"/>
            <field name="sub_assignee_ids" widget="many2many_tags" domain="[('share', '=', False)]" options="{'no_create': True}"/>
            <field name="number_of_passengers"/>
        </xpath>
        </field>
</record>




<record id="crm_lead_search_inherit_travel_filters" model="ir.ui.view">
    <field name="name">crm.lead.search.inherit.travel.filters</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
    <field name="arch" type="xml">

        <xpath expr="//search/field[1]" position="before">
            <field name="destination" string="Destination" filter_domain="[('destination', 'ilike', self)]"/>
            <field name="partner_id" string="Client Name"/>
            <field name="user_id" string="Employee Owner"/>
        </xpath>

        <xpath expr="//group" position="before">
            <separator/>
            <!-- <filter string="My Pipeline" name="my_pipeline_with_sub"
                    domain="['|', ('user_id', '=', uid), ('sub_assignee_ids', 'in', [uid])]"/>
            <separator/> -->
            <filter string="Today" name="today" 
                    domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), 
                             ('create_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
            <filter string="Last 7 Days" name="travel_last_7_days"
                domain="[
                    ('travel_date_from', '&gt;=', (context_today() + relativedelta(days=-7)).strftime('%Y-%m-%d 00:00:00')),
                    ('travel_date_from', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))
                ]"/>
            <filter string="Last 30 Days" name="travel_last_30_days"
                domain="[
                    ('travel_date_from', '&gt;=', (context_today() + relativedelta(days=-30)).strftime('%Y-%m-%d 00:00:00')),
                    ('travel_date_from', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))
                ]"/>
            <filter string="Last 60 Days" name="travel_last_60_days"
                domain="[
                    ('travel_date_from', '&gt;=', (context_today() + relativedelta(days=-60)).strftime('%Y-%m-%d 00:00:00')),
                    ('travel_date_from', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))
                ]"/>
            <separator/>
        </xpath>

        <xpath expr="//group" position="inside">
            <filter string="Destination" name="group_by_destination" context="{'group_by': 'destination'}"/>
            <filter string="Client Name" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
            <filter string="Employee Owner" name="group_by_user" context="{'group_by': 'user_id'}"/>
        </xpath>

        <!-- <xpath expr="//filter[@name='assigned_to_me']" position="after">
            <filter string="Assigned Quotations" 
                    name="assigned_to_my_quotations" 
                    domain="[('quotation_ids.assign_to_id', '=', uid)]"/>
        </xpath> -->
         
    </field>
</record>


<record id="crm_lead_search_inherit_clean_filters" model="ir.ui.view">
    <field name="name">crm.lead.search.inherit.clean.filters</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
    <field name="arch" type="xml">
        <xpath expr="//filter[@name='unassigned']" position="replace"/>
        <xpath expr="//filter[@name='assigned_to_me']" position="replace">
            <filter string="My Pipeline" name="assigned_to_me"
                    domain="['|', ('user_id', '=', uid), ('sub_assignee_ids', 'in', [uid])]"/>
        </xpath>
        <xpath expr="//filter[@name='open_opportunities']" position="replace"/>
        <xpath expr="//filter[@name='message_needaction']" position="replace"/>
        <xpath expr="//filter[@name='creation_date']" position="replace"/>
        <xpath expr="//filter[@name='close_date']" position="replace"/>
        <xpath expr="//filter[@name='filter_won_status_pending']" position="replace"/>
        <xpath expr="//filter[@name='filter_rotting']" position="replace"/>
        <xpath expr="//filter[@name='salesperson']" position="replace"/>
        <xpath expr="//filter[@name='saleschannel']" position="replace"/>
        <xpath expr="//filter[@name='city']" position="replace"/>
        <xpath expr="//filter[@name='country']" position="replace"/>
    </field>
</record>



<record id="view_crm_case_opportunities_filter_inherit" model="ir.ui.view">
    <field name="name">crm.lead.search.opportunity.inherit</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
    <field name="arch" type="xml">
        <xpath expr="//filter[@name='source']" position="replace"/>
        <xpath expr="//filter[@name='company']" position="replace"/>
        <xpath expr="//filter[@name='compaign']" position="replace"/>
        <xpath expr="//filter[@name='medium']" position="replace"/>
        <xpath expr="//filter[@name='lostreason']" position="replace"/>
        <xpath expr="//filter[@name='date_closed']" position="replace"/>
        <xpath expr="//filter[@name='group_by_lead_properties']" position="replace"/>
        <xpath expr="//filter[@name='group_by_create_date_day']" position="replace"/>
        <xpath expr=".//filter[@name='month']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>

        <xpath expr=".//filter[@name='date_deadline']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
    </field>
</record>


<record id="crm_lead_view_tree_inherit_priority_colors" model="ir.ui.view">
        <field name="name">crm.lead.tree.inherit.priority.colors</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">priority == '1'</attribute>
                <attribute name="decoration-success">priority == '2'</attribute>
                <attribute name="decoration-danger">priority == '3'</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="before">
                <field name="create_date" string="Created On" widget="custom_datetime"/>
            </xpath>
        </field>
</record>


<record id="crm_iap_enrich.crm_lead_view_form" model="ir.ui.view">
    <field name="active">False</field>
</record>



<record id="crm_case_kanban_view_leads_inherit_custom_avatar" model="ir.ui.view">
    <field name="name">crm.lead.kanban.inherit.custom.avatar</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='partner_id'][@widget='many2one_avatar']" position="replace">
            <img t-attf-src="/web/image/res.partner/{{record.partner_id.raw_value}}/avatar_128"
                 class="oe_kanban_avatar rounded-circle"
                 style="width: 24px; height: 24px; object-fit: cover;"
                 onerror="this.src='/jt_travel/static/img/avatar_custom_grey.png'"
                 alt="Contact Avatar"/>
        </xpath>


        <xpath expr="//kanban//footer//field[@name='user_id']" position="replace">
            <div class="ms-auto d-flex align-items-center gap-1">
             <span t-esc="record.user_id.value" class="small text-muted"/>
                <field name="user_id" widget="many2one_avatar_user" domain="[('share', '=', False)]"/>
            </div>
        </xpath>
    </field>
</record>




<record id="crm_lead_quick_add_form_view_inherit" model="ir.ui.view">
        <field name="name">crm.lead.quick.add.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
 
            <xpath expr="//div[contains(@class,'d-flex')][.//field[@name='commercial_partner_id']]" position="replace"/>
 
            <xpath expr="//div[contains(@class,'d-flex')][.//field[@name='partner_id']]" position="before">
                <div class="d-flex align-items-center" colspan="2">
                    <i class="fa fa-briefcase" title="Lead Name"/>
                    <field name="name"
                        string="File Name"
                        placeholder="File Name"
                        nolabel="1"
                        class="o_field_highlight w-100 mb-0"/>
                </div>
            </xpath>
 
            <xpath expr="//div[contains(@class,'d-flex')][.//field[@name='name']][last()]" position="replace"/>
 
            <xpath expr="//div[contains(@class,'d-flex')][.//field[@name='expected_revenue']]" position="replace"/>
 
            <xpath expr="//div[contains(@class,'d-flex')][.//field[@name='recurring_revenue']]" position="replace"/>
 
            <xpath expr="//div[contains(@class,'d-flex')][.//field[@name='phone']]" position="after">
                <div class="d-flex align-items-center" colspan="2">
                    <i class="fa fa-tag" title="Lead Type"/>
                    <field name="lead_type_id"
                        string="Lead Type"
                        placeholder="Lead Type"
                        nolabel="1"
                        class="o_field_highlight w-100 mb-0"
                        options="{'no_create': True, 'no_open': True}"/>
                </div>
            </xpath>
 
            <xpath expr="//field[@name='user_id'][@invisible='1']" position="replace"/>


                <field name="partner_id" position="attributes">
                    <attribute name="string">Contact Name</attribute>
                    <attribute name="placeholder">Contact Name</attribute>
                    <attribute name="domain">[('user_ids', '=', False)]</attribute>
                </field>

            <xpath expr="//div[contains(@class,'d-flex')][.//field[@name='lead_type_id']]" position="after">
                <field name="allowed_user_ids" invisible="1"/>
                <div class="d-flex align-items-center" colspan="2">
                    <i class="fa fa-user-circle" title="Lead Owner"/>
                    <field name="user_id"
                        string="Lead Owner"
                        placeholder="Lead Owner"
                        nolabel="1"
                        class="o_field_highlight w-100 mb-0"
                        domain="[('share', '=', False), ('id', 'in', allowed_user_ids)]"/>
                </div>
            </xpath>
        </field>
</record>

<record id="crm_lead_hide_quotations_smart_button" model="ir.ui.view">
        <field name="name">crm.lead.hide.quotations.smart.button</field>
