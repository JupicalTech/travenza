<record id="view_attachment_form_preview" model="ir.ui.view">
    <field name="name">ir.attachment.form.preview</field>
    <field name="model">ir.attachment</field>
    <field name="inherit_id" ref="base.view_attachment_form"/>
    <field name="arch" type="xml">
        <xpath expr="//form/sheet" position="inside">
            <group string="Preview" invisible="type != 'binary' or not datas">
                <div colspan="2" class="text-center">
                    <field name="datas" widget="pdf_viewer"
                           invisible="mimetype and 'pdf' not in mimetype"
                           nolabel="1"/>
                    <field name="datas" widget="image"
                           invisible="not mimetype or 'image' not in mimetype"
                           nolabel="1"
                           style="max-width: 100%; max-height: 600px;"/>
                </div>
            </group>
        </xpath>
    </field>
</record>


