<!-- Travenza: All Tasks action filtered to Travenza stages only -->
<record id="jt_action_view_my_task" model="ir.actions.act_window">
    <field name="name">My Tasks</field>
    <field name="res_model">project.task</field>
    <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
    <field name="search_view_id" ref="project.view_task_search_form"/>
    <field name="context">{
        'search_default_my_tasks': 1,
        'search_default_open_tasks': 1,
        'jt_travel_tasks': True
    }</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No tasks found.</p>
    </field>
</record>


<record id="jt_action_view_all_task" model="ir.actions.act_window">
    <field name="name">All Tasks</field>
    <field name="res_model">project.task</field>
    <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
    <field name="search_view_id" ref="project.view_task_search_form"/>
    <field name="context">{
        'search_default_open_tasks': 1,
        'jt_travel_tasks': True
    }</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No tasks found.</p>
    </field>
</record>




    <menuitem
    id="crm_menu_my_tasks"
    name="My Tasks"
    parent="jt_travel.crm_menu_tasks"
    action="jt_travel.jt_action_view_my_task"
    sequence="1"/>

    <menuitem
    id="crm_menu_all_tasks"
    name="All Tasks"
    parent="jt_travel.crm_menu_tasks"
    action="jt_travel.jt_action_view_all_task"
    sequence="2"/>


</odoo>