<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_type_list" model="ir.ui.view">
        <field name="name">lead.type.list</field>
        <field name="model">lead.type</field>
        <field name="arch" type="xml">
            <list editable="bottom" sample="1">
                <field name="name"/>
                <field name="team_ids" widget="many2many_tags"/>
                <field name="is_project_type"/>
                <field name="tag_ids" 
                       widget="many2many_tags" 
                       options="{'color_field': 'color'}"/>
            </list>
        </field>
    </record>

    <record id="view_lead_type_form" model="ir.ui.view">
        <field name="name">lead.type.form</field>
        <field name="model">lead.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group name="mapping_config" string="Mapping Configuration">
                            <field name="team_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="is_project_type"/>
                        </group>
                        <group name="tag_config" string="Automation">
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lead_type_config" model="ir.actions.act_window">
        <field name="name">Lead Type Mapping</field>
        <field name="res_model">lead.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Map your Lead Types to Teams here.
            </p>
            <p>
                Configure which team handles specific services and if they require projects.
            </p>
        </field>
    </record>

    <menuitem id="menu_lead_type_config"
              name="Lead Type Mapping"
              parent="crm.menu_crm_config_lead"
              action="action_lead_type_config"
              groups="jt_travel.group_travenza_holidays_manager,jt_travel.group_travenza_holidays_admin"
              sequence="50"/>
</odoo>