<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_visa_application_form" model="ir.ui.view">
        <field name="name">customer.visa.application.form</field>
        <field name="model">customer.visa.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    
                    <button name="action_approve" 
                            string="Approve Visa" 
                            type="object" 
                            class="btn-success" 
                            invisible="result in ['approved', 'rejected']"/>

                    <button name="action_delay" 
                            string="Mark Delayed" 
                            type="object" 
                            class="btn-warning"
                            invisible="result in ['approved', 'rejected', 'delayed']"/>

                    <button name="action_reject" 
                            string="Reject Visa" 
                            type="object" 
                            class="btn-danger"
                            invisible="result in ['approved', 'rejected']"/>
                    
                    <field name="result" widget="statusbar" statusbar_visible="in_progress,approved,rejected,delayed"/>
                </header>
                <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="visa_sequence" readonly="1"/>
                    </h1>
                </div>
                    <group>
                        <group string="Visa Details">
                            <field name="customer_id" required="1"/>
                            <field name="country_id" required="1"/>
                            <field name="visa_type_id" required="1"/>
                            <field name="tracking_number"/>
                            <field name="passport_number"/>
                        </group>
                        <group string="Dates and Status">
                            <field name="appointment_date"/>
                            <field name="submission_date"/>
                            <field name="is_biometric_required" 
                                    invisible="biometrics_status == 'approved'"/>
                                
                            <field name="biometrics_status" 
                                    readonly="1" 
                                    invisible="not is_biometric_required and biometrics_status != 'approved'"/>
                                
                            <field name="biometric_filename" invisible="1"/>
                            <field name="biometric_file" 
                                    filename="biometric_filename" 
                                    string="Upload Biometric"
                                    invisible="not is_biometric_required and biometrics_status != 'approved'"/>
                            <field name="validity_period"/>
                        </group>
                    </group>

                    <group string="Required Documents" invisible="not country_id">
                        <field name="show_aadhar" invisible="1"/>
                        <field name="show_pan" invisible="1"/>
                        <field name="show_passport" invisible="1"/>
                        <field name="show_photo" invisible="1"/>
                        <field name="show_bank_statement" invisible="1"/>
                        <field name="show_voter_id" invisible="1"/>

                        <field name="has_aadhar" invisible="not show_aadhar"/>
                        <field name="has_pan" invisible="not show_pan"/>
                        <field name="has_passport" invisible="not show_passport"/>
                        <field name="has_photo" invisible="not show_photo"/>
                        <field name="has_bank_statement" invisible="not show_bank_statement"/>
                        <field name="has_voter_id" invisible="not show_voter_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_customer_visa_application_list" model="ir.ui.view">
        <field name="name">customer.visa.application.list</field>
        <field name="model">customer.visa.application</field>
        <field name="arch" type="xml">
            <list string="Visa Applications">
                <field name="visa_sequence"/>
                <field name="customer_id"/>
                <field name="country_id"/>
                <field name="visa_type_id"/>
                <field name="passport_number"/>
                <field name="tracking_number"/>
                <field name="appointment_date"/>
                <field name="biometrics_status"/>
                <field name="submission_date"/>
                <field name="validity_period"/>
                <field name="result" widget="badge" decoration-success="result == 'approved'"
                                                    decoration-info="result == 'delayed'"
                                                    decoration-danger="result == 'rejected'"/>
            </list>
        </field>
    </record>



    <record id="view_customer_visa_application_search" model="ir.ui.view">
    <field name="name">customer.visa.application.search</field>
    <field name="model">customer.visa.application</field>
    <field name="arch" type="xml">
        <search string="Search Visa Applications">
            <field name="visa_sequence" string="Serial Number"/>
            <field name="customer_id" string="Applicant"/>
            <field name="passport_number"/>
            <field name="tracking_number"/>
            <field name="country_id"/>

            <separator/>
            <filter string="Approved" name="approved" domain="[('result', '=', 'approved')]"/>
            <filter string="In Progress" name="in_progress" domain="[('result', '=', 'in_progress')]"/>
            <filter string="Rejected" name="rejected" domain="[('result', '=', 'rejected')]"/>
            <separator/>
            <filter string="Biometric Pending" name="biometric_pending" domain="[('biometrics_status', '=', 'pending')]"/>
            <filter string="Biometric Approved" name="biometric_appr" domain="[('biometrics_status', '=', 'approved')]"/>
            
            <group>
                <filter string="Applicant" name="group_by_customer" context="{'group_by': 'customer_id'}"/>
                <filter string="Country" name="group_by_country" context="{'group_by': 'country_id'}"/>
                <filter string="Visa Type" name="group_by_visa_type" context="{'group_by': 'visa_type_id'}"/>
                <filter string="Status" name="group_by_result" context="{'group_by': 'result'}"/>
                <separator/>
                <filter string="Appointment Date" name="group_by_app_date" context="{'group_by': 'appointment_date'}"/>
            </group>
            </search>
        </field>
    </record>

    <record id="view_customer_visa_application_kanban" model="ir.ui.view">
    <field name="name">customer.visa.application.kanban</field>
    <field name="model">customer.visa.application</field>
    <field name="arch" type="xml">
        <kanban default_group_by="result" class="o_kanban_small_column" can_open="1">

            <field name="visa_sequence"/>
            <field name="customer_id"/>
            <field name="country_id"/>
            <field name="visa_type_id"/>
            <field name="passport_number"/>
            <field name="appointment_date"/>
            <field name="submission_date"/>
            <field name="tracking_number"/>
            <field name="validity_period"/>
            <field name="result"/>
            <field name="biometrics_status"/>

            <templates>

                <t t-name="card">

                    <div class="o_kanban_record oe_kanban_global_click p-0 border-0 bg-white"
                         style="border-radius: 12px; overflow: hidden; transition: transform 0.2s ease;">

                        <div class="position-relative">

                            <div t-if="record.result.raw_value == 'approved'"
                                 class="ribbon ribbon-top-right">
                                <span class="bg-success text-white small">APPROVED</span>
                            </div>

                            <div t-if="record.result.raw_value == 'rejected'"
                                 class="ribbon ribbon-top-right">
                                <span class="bg-danger text-white small">REJECTED</span>
                            </div>

                            <div t-if="record.result.raw_value == 'delayed'"
                                 class="ribbon ribbon-top-right">
                                <span class="bg-warning text-dark small">DELAYED</span>
                            </div>

                            <div t-if="record.result.raw_value == 'in_progress'"
                                 class="ribbon ribbon-top-right">
                                <span class="bg-info text-white small">IN PROGRESS</span>
                            </div>

                        </div>

                        <div class="p-3">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="m-0 fw-bold text-dark">
                                    <field name="visa_sequence"/>
                                </h4>
                            </div>

                            <div class="text-muted mb-3 d-flex align-items-center">
                                <div class="bg-primary-light rounded-circle d-flex align-items-center justify-content-center me-2"
                                     style="width:24px;height:24px;">
                                    <i class="fa fa-user text-primary small"/>
                                </div>
                                <span class="fw-semibold text-truncate">
                                    <field name="customer_id"/>
                                </span>
                            </div>

                            <div class="bg-light rounded p-2 mb-3 d-flex align-items-center justify-content-center border-dashed border-2">

                                <div class="text-center flex-grow-1">
                                    <small class="d-block text-muted text-uppercase">Country</small>
                                    <span class="fw-bold">
                                        <field name="country_id"/>
                                    </span>
                                </div>

                                <div class="px-2">
                                    <i class="fa fa-arrow-right text-primary fa-lg"/>
                                </div>

                                <div class="text-center flex-grow-1">
                                    <small class="d-block text-muted text-uppercase">Visa</small>
                                    <span class="fw-bold">
                                        <field name="visa_type_id"/>
                                    </span>
                                </div>

                            </div>

                            <div class="mb-2">
                                <span class="text-muted">
                                    Passport No: <field name="passport_number"/>
                                </span>
                            </div>

                            <div class="row g-0 pt-2 border-top">

                                <div class="col-4 border-end">
                                    <small class="text-muted d-block fw-bold">Appointment</small>
                                    <span class="fw-bold text-dark">
                                        <field name="appointment_date"/>
                                    </span>
                                </div>

                                <div class="col-4 border-end ps-2">
                                    <small class="text-muted d-block fw-bold">Submission</small>
                                    <span class="fw-bold text-dark">
                                        <field name="submission_date"/>
                                    </span>
                                </div>

                                <div class="col-4 ps-2">
                                    <small class="text-muted d-block fw-bold">Biometrics</small>
                                    <t t-if="record.biometrics_status.raw_value == 'pending'">
                                        <span class="fw-bolder text-danger fs-6">
                                            <field name="biometrics_status"/>
                                        </span>
                                    </t>

                                    <t t-if="record.biometrics_status.raw_value == 'approved'">
                                        <span class="fw-bolder text-success fs-6">
                                            <field name="biometrics_status"/>
                                        </span>
                                    </t>
                                </div>

                            </div>

                        </div>

                        <div class="o_kanban_record_manage_settings p-2 text-end">
                            <t t-call="menu"/>
                        </div>

                    </div>

                </t>

                <t t-name="menu">

                    <div class="o_kanban_card_manage_pane dropdown-menu" role="menu">

                        <div class="o_kanban_card_manage_section">

                            <div role="menuitem" class="dropdown-header">
                                Visa Actions
                            </div>

                            <a role="menuitem"
                               type="object"
                               name="action_mark_in_progress"
                               class="dropdown-item">
                               Mark In Progress
                            </a>

                            <a role="menuitem"
                               type="object"
                               name="action_mark_approved"
                               class="dropdown-item">
                               Approve Visa
                            </a>

                            <a role="menuitem"
                               type="object"
                               name="action_mark_rejected"
                               class="dropdown-item text-danger">
                               Reject Visa
                            </a>

                        </div>

                    </div>

                </t>

            </templates>

        </kanban>
    </field>
</record>


    <record id="action_customer_visa_application" model="ir.actions.act_window">
        <field name="name">Visa Applications</field>
        <field name="res_model">customer.visa.application</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_customer_visa_application_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Visa Application!
            </p>
        </field>
    </record>

    <menuitem id="menu_customer_visa_application"
              name="Visa Applications"
              action="action_customer_visa_application"
              parent="crm.crm_menu_root"
              sequence="4"/>

</odoo>