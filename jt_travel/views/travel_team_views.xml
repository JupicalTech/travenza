<?xml version="1.0" encoding="utf-8"?>
<odoo>


<record id="view_travel_team_type_form" model="ir.ui.view">
    <field name="name">travel.team.type.form</field>
    <field name="model">travel.team.type</field>
    <field name="arch" type="xml">
        <form string="Team Type">
            <sheet>
                <group>
                    <field name="name" string="Team Type"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="view_travel_team_type_list" model="ir.ui.view">
    <field name="name">travel.team.type.list</field>
    <field name="model">travel.team.type</field>
    <field name="arch" type="xml">
        <list string="Team Types">
            <field name="name"/>
        </list>
    </field>
</record>

<record id="view_travel_team_list" model="ir.ui.view">
    <field name="name">travel.team.list</field>
    <field name="model">travel.team</field>
    <field name="arch" type="xml">
        <list string="Teams">
            <field name="name"/>
            <field name="team_type_id"/>
            <field name="team_leader_id"/>
        </list>
    </field>
</record>

<record id="view_travel_team_form" model="ir.ui.view">
    <field name="name">travel.team.form</field>
    <field name="model">travel.team</field>
    <field name="arch" type="xml">
        <form string="Team">
            <sheet>
                <group>
                    <field name="assigned_user_ids" invisible="1"/>
                    <field name="name"/>
                    <field name="team_type_id" required="1"/>
                    <field name="team_leader_id"  options="{'no_open': True, 'no_create': True}"/>
                </group>
                <notebook>
                    <page string="Members">
                        <field name="member_ids" widget="many2many_avatar_user"  options="{'no_open': True, 'no_create': True}"/>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>


<record id="action_travel_teams" model="ir.actions.act_window">
    <field name="name">Travenza Teams</field>
    <field name="res_model">travel.team</field>
    <field name="view_mode">list,form</field>
</record>

<record id="action_travel_team_types" model="ir.actions.act_window">
    <field name="name">Travenza Team Types</field>
    <field name="res_model">travel.team.type</field>
    <field name="view_mode">list,form</field>
</record>

<menuitem id="menu_travel_teams_root"
          name="Travenza Teams"
          parent="crm.crm_menu_config"
          sequence="6"/>


<menuitem id="menu_travel_teams"
          name="Teams"
          parent="menu_travel_teams_root"
          action="action_travel_teams"
          sequence="2"/>



<menuitem id="menu_travel_team_types"
          name="Team Types"
          parent="menu_travel_teams_root"
          action="action_travel_team_types"
          sequence="3"/>
</odoo>