<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_country_specific_checklist_list" model="ir.ui.view">
        <field name="name">country.specific.checklist.list</field>
        <field name="model">country.specific.checklist</field>
        <field name="arch" type="xml">
            <list string="Country Checklists">
                <field name="country_id"/>
                <field name="has_aadhar"/>
                <field name="has_pan"/>
                <field name="has_passport"/>
                <field name="has_bank_statement"/>
            </list>
        </field>
    </record>

    <record id="view_country_specific_checklist_form" model="ir.ui.view">
        <field name="name">country.specific.checklist.form</field>
        <field name="model">country.specific.checklist</field>
        <field name="arch" type="xml">
            <form string="Country Checklist">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="country_id" placeholder="Select Country..." required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identity Documents">
                            <field name="has_aadhar"/>
                            <field name="has_pan"/>
                            <field name="has_voter_id"/>
                        </group>
                        <group string="Travel and Finance">
                            <field name="has_passport"/>
                            <field name="has_photo"/>
                            <field name="has_bank_statement"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_country_specific_checklist" model="ir.actions.act_window">
        <field name="name">Country Checklists</field>
        <field name="res_model">country.specific.checklist</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_country_specific_checklist"
              name="Country Checklists"
              action="action_country_specific_checklist"
              parent="crm.crm_menu_config"
              sequence="4"/>
</odoo>