<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_travel_quotation_form" model="ir.ui.view">
	    <field name="name">travel.quotation.form</field>
	    <field name="model">travel.quotation</field>
	    <field name="arch" type="xml">
	        <form string="Travel Quotation">
			<header>
                    <button name="action_create_tasks" 
                            string="Create Tasks" 
                            type="object" 
                            class="oe_highlight" 
                           invisible="not is_project_type or not has_project or is_only_assignee"/>
            </header>
				
	            <sheet>
				<field name="is_only_assignee" invisible="1"/>

				<div class="oe_title">
					<h1>
						<field name="name" readonly="1"/>
					</h1>
				</div>
				
				<field name="is_holiday_type" invisible="1"/>
				<field name="is_project_type" invisible="1"/>
                <field name="has_project" invisible="1"/>

	            	<group>
		                <group>
        				<field name="version" readonly="1"/>
		                	<field name="destination"/>
		                	<label for="travel_date_from" string="Travel Dates"/>
				            <div class="o_row">
				                <field name="travel_date_from" nolabel="1" class="oe_inline" placeholder="From" widget="custom_datetime"/>
				                <i class="fa fa-long-arrow-right mx-2 mt-1 text-muted" title="Arrow" aria-label="Next step" aria-hidden="true"/>
				                <field name="travel_date_to" nolabel="1" class="oe_inline" placeholder="To" widget="custom_datetime"/>
				            </div>
		                </group>
		                <group>
		                	<field name="number_of_passengers"/>
		                	<field name="lead_type_id" options="{'no_create': True, 'no_open': True}"/>
							<field name="assign_to_id" widget="many2one_avatar_user"/>
		                </group>
		            </group>

	                <notebook>
	                    <page string="Quotation Lines">
	                        <!-- <field name="line_ids" class="o_list_bordered"> -->
							 <field name="line_ids">
	                            <list editable="bottom">
									<field name="sequence" widget="handle"/>
									<field name="lead_type_ids" 
									widget="many2many_tags" 
									options="{'no_create': True, 'no_open': True}"
									readonly="parent.is_only_assignee"
									column_invisible="not parent.is_project_type or not parent.is_lead_won"/>
									<field name="available_assignee_ids" column_invisible="1"/>
	                                <field name="date"/>
	                                <field name="description"/>
	                                <field name="price"/>
									<field name="remark"/>
									<field name="task_assignee_ids" 
									widget="many2many_tags" 
									domain="[('id', 'in', available_assignee_ids)]" 
									options="{'no_create': True, 'no_open': True}"
									readonly="parent.is_only_assignee"
									column_invisible="not parent.is_project_type or not parent.is_lead_won"/>
	                            </list>
	                        </field>
	                    </page>
	                </notebook>
					<group>
					<group>
					<field name="working" nolabel="1" placeholder="Working"/></group>
                    	<group></group>
                	</group>
	                <group>
					    <group class="oe_subtotal_footer oe_right" colspan="2">
					        <field name="total_amount" readonly="1"/>
					        <field name="markup"/>
					        <field name="client_cost" readonly="1"/>
					    </group>
					</group>
	            </sheet>
                <chatter/>
	        </form>
	    </field>
	</record>

    <record id="travel_quotation_tree_view" model="ir.ui.view">
        <field name="name">travel.quotation.list</field>
        <field name="model">travel.quotation</field>
        <field name="arch" type="xml">
            <list string="Travel Quotations">
				<field name="name" readonly="1"/>
				<field name="version" readonly="1"/>
                <field name="destination"/>
                <field name="travel_date_from" widget="custom_datetime"/>
                <field name="travel_date_to" widget="custom_datetime"/>
                <field name="number_of_passengers"/>
                <field name="lead_type_id" widget="badge" options="{'no_create': True, 'no_open': True}"/>	
				<field name="assign_to_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>


	<record id="action_my_travel_quotations" model="ir.actions.act_window">
    <field name="name">Quotations</field>
    <field name="res_model">travel.quotation</field>
    <field name="view_mode">list,form</field>
</record>

<menuitem id="menu_my_travel_quotations"
          name="Quotations"
          parent="crm.crm_menu_sales"
          sequence="2"
          action="action_my_travel_quotations"
          groups="jt_travel.group_travenza_holidays_user,jt_travel.group_travenza_holidays_manager,jt_travel.group_travenza_holidays_admin"/>

</odoo>