<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_project_form_simplified_hide_billable" model="ir.ui.view">
    <field name="name">project.project.form.simplified.hide.billable</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="sale_project.project_project_view_form_simplified_inherit"/>
    <field name="arch" type="xml">
        <xpath expr="//setting[field[@name='allow_billable']]" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
    </field>
</record>



<record id="view_project_project_form_inherit_travel" model="ir.ui.view">
    <field name="name">project.project.form.inherit.travel</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="arch" type="xml">

    <xpath expr="//group//group//field[@name='label_tasks']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>

        <xpath expr="//field[@name='user_id']" position="attributes">
            <attribute name="tracking">1</attribute>
        </xpath>

        <xpath expr="//group//group//field[@name='company_id']" position="after">
            <field name="package_name"/>
            <field name="destination"/>
            <field name="number_of_passengers"/>
        </xpath>

        <xpath expr="//field[@name='date']" position="after">
            <label for="travel_date_from" string="Travel Date from"/>
            <div class="o_row">
                <field name="travel_date_from" nolabel="1" class="oe_inline" placeholder="From" widget="custom_datetime"/>
                 <i class="fa fa-long-arrow-right mx-2 mt-1 text-muted" title="Arrow" aria-label="Arrow"/>
                <field name="travel_date_to" nolabel="1" class="oe_inline" placeholder="To" widget="custom_datetime"/>
            </div>

            
            <field name="lead_currency_id" invisible="1"/>
            <field name="client_price" widget="monetary" options="{'currency_field': 'lead_currency_id'}"/>
            <field name="advance_payment" widget="monetary" options="{'currency_field': 'lead_currency_id'}"/>            
        </xpath>



        <xpath expr="//div[@name='button_box']" position="inside">
            <button name="action_view_project_documents"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-paperclip">
                <field name="document_count" widget="statinfo" string="Documents"/>
            </button>
            <button name="action_view_spreadsheets"
                type="object"
                    class="oe_stat_button"
                    icon="fa-table"
                    invisible="spreadsheet_count == 0">
                <field name="spreadsheet_count" widget="statinfo" string="Spreadsheets"/>
            </button>
        </xpath>


        <xpath expr="//header" position="inside">
            <button name="action_bulk_assign_quotation_lines"
                    type="object"
                    string="Bulk Assign"
                    class="btn btn-secondary"
                    icon="fa-users"/>
        </xpath>


       <xpath expr="//sheet" position="inside">
            <notebook>
                <page string="Quotation Lines" name="quotation_lines_page">
                    <field name="quotation_line_ids" nolabel="1">
                        <list editable="bottom" class="o_list_bordered">
                            <field name="available_assignee_ids" column_invisible="1"/>
                            <field name="selected" string="✓" widget="boolean_toggle"/>
                            <field name="date"/>
                            <field name="description"/>
                            <field name="price" string="Est. Price"/>
                            <field name="booked_price"/>
                            <field name="lead_type_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="assignee_ids" widget="many2many_tags"
                                   domain="[('id', 'in', available_assignee_ids)]"
                                   options="{'no_create': True}"/>
                            <field name="vendor_reference"/>
                            <field name="mode_of_payment"/>
                            <field name="remark"/>
                            <field name="stage_id" options="{'no_create': True, 'no_open': True}"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </xpath>
        
        <xpath expr="//group[@name='group_tasks_managment']" position="replace"/>
        <xpath expr="//button[contains(@name,'action_view_tasks')]" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='alias_id']" position="replace"/>
        <xpath expr="//field[@name='date_start']" position="replace"/>
        <xpath expr="//label[@for='alias_name']" position="replace"/>
        <xpath expr="//field[@name='alias_email']" position="replace"/>
        <xpath expr="//div[hasclass('d-inline-flex')]" position="replace"/>
        <xpath expr="//field[@name='alias_contact']" position="replace"/>
        <xpath expr="//page[@name='description']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='settings']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        </field>
</record>

<record id="project.project_kanban_view_group_stage" model="ir.ui.view">
    <field name="active" eval="False"/>
</record>
<record id="project.menu_project_management" model="ir.ui.menu">
    <field name="active" eval="False"/>
</record>

<record id="project_kanban_hide_status_dot" model="ir.ui.view">
    <field name="name">project.project.kanban.hide.status</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.view_project_kanban"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='last_update_status'][@widget='project_state_selection']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>

        <xpath expr="//span[@t-att-class and @t-att-title]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
    </field>
</record>



<record id="view_project_project_filter_inherit" model="ir.ui.view">
    <field name="name">project.project.select.inherit</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.view_project_project_filter"/>
    <field name="arch" type="xml">
        <xpath expr="//filter[@name='late_milestones']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//filter[@name='templates']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//filter[@name='inactive']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//filter[@name='Manager']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//filter[@name='groupby_stage']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//filter[@name='company']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
    </field>
</record>

<record id="project_list_hide_status_dot" model="ir.ui.view">
    <field name="name">project.project.list.hide.status</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.view_project"/> 
    <field name="arch" type="xml">
        <xpath expr="//field[@name='last_update_status'][@widget='project_state_selection']" position="attributes">
            <attribute name="column_invisible">1</attribute>
        </xpath>

        <xpath expr="//field[@name='name']" position="before">
            <field name="proj_seq" string="Reference" class="fw-bold"/>
        </xpath>

        <xpath expr="//field[@name='partner_id']" position="attributes">
            <attribute name="column_invisible">1</attribute>
        </xpath>
    </field>
</record>


<record id="view_project_project_calendar_travel" model="ir.ui.view">
    <field name="name">project.project.calendar.travel</field>
    <field name="model">project.project</field>
    <field name="arch" type="xml">
        <calendar string="Travel Plan" 
                  date_start="travel_date_from" 
                  mode="month"
                  color="lead_type_name" 
                  hide_time="true"
                  event_open_popup="true">
            <field name="name"/> 
            <field name="travel_date_from" widget="custom_datetime"/>
            <field name="travel_date_to" widget="custom_datetime"/>
            <field name="lead_type_name" filters="1"/> 
            <field name="destination"/>
        </calendar>
    </field>
</record>


<delete model="ir.actions.act_window.view" 
        search="[('act_window_id', '=', ref('project.open_view_project_all'))]"/>

<record id="action_project_all_list_view" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="project.view_project"/>
    <field name="act_window_id" ref="project.open_view_project_all"/>
</record>

<record id="action_project_all_kanban_view" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="project.view_project_kanban"/>
    <field name="act_window_id" ref="project.open_view_project_all"/>
</record>

<record id="action_project_all_calendar_view" model="ir.actions.act_window.view">
    <field name="sequence" eval="3"/>
    <field name="view_mode">calendar</field>
    <field name="view_id" ref="view_project_project_calendar_travel"/>
    <field name="act_window_id" ref="project.open_view_project_all"/>
</record>

<record id="project.open_view_project_all" model="ir.actions.act_window">
    <field name="view_mode">list,kanban,calendar,form</field>
</record>

</odoo>